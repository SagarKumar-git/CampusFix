# ==============================================================================
# CampusFix — Git Ignore Rules
# ==============================================================================

# Environment & Secrets (Never commit actual credentials or secrets)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Python Testing & Tooling Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Node.js & Frontend Tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.vite/

# Temporary & Database Files
*.sqlite
*.sqlite3
*.db
*.log

# OS & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
