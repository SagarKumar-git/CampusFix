# ==============================================================================
# CampusFix — Root Environment Configuration Template
# ==============================================================================
# Notice: This file documents required environment variables across the project.
# Copy appropriate variables to backend/.env and frontend/.env respectively.
# NEVER commit production secrets or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------

# Application Environment ('development', 'staging', 'production')
ENVIRONMENT=development

# Database Connection (Async SQLAlchemy format for PostgreSQL 15+)
# Example: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/campusfix

# JWT Signing Secret (Generate with: openssl rand -hex 32)
# Minimum 32 bytes (64 hex characters) in production
SECRET_KEY=placeholder_secret_key_minimum_64_hex_chars_for_development_only0000

# JWT Cryptographic Signing Algorithm
ALGORITHM=HS256

# Access Token Expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh Token Cookie Expiry (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------

# REST API Base URL for Vite Client
VITE_API_BASE_URL=http://localhost:8000/api/v1
