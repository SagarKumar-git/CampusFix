# ==============================================================================
# CampusFix — Local Docker Compose Environment Template (.env)
# ==============================================================================
# Copy this file to .env before running docker compose if you wish to override
# default development credentials or local port mappings.
#
# Usage:
#   cp .env.docker.example .env
#   docker compose up -d
#   docker compose run --rm backend alembic upgrade head
# ==============================================================================

# Database Credentials (Local development container only)
POSTGRES_USER=campusfix_user
POSTGRES_PASSWORD=campusfix_dev_password
POSTGRES_DB=campusfix
POSTGRES_PORT=5432

# Backend Security
SECRET_KEY=placeholder_secret_key_minimum_64_hex_chars_for_development_only0000

# Frontend Build Arguments (Defaults to relative /api/v1 for same-origin proxying)
VITE_API_BASE_URL=/api/v1
